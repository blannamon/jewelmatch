# Local Vite settings. These values are public client configuration, not secrets.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-supabase-publishable-key
# Set true only after the `telegram` OIDC provider is configured in Supabase Auth.
VITE_SUPABASE_TELEGRAM_ENABLED=false
